    "dev": "pnpm --parallel --filter @unpaidinterns/server --filter @unpaidinterns/web dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}

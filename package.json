{
  "name": "unpaidinterns",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
